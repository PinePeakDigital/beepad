      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "postcss": "^8.5.25",
      "sharp": "^0.35.3",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.17"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "knip": "^5.56.0",
    "typescript": "^5.8.3"
